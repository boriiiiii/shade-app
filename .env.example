# ============================================================================
# Shade — exemple d'environnement (copie ce fichier en `.env` et adapte)
# AUCUN secret réel ne doit être commit. `.env` est git-ignored.
# ============================================================================

# ---- Runtime ----
ENV=dev                       # dev | staging | prod

# ---- PostgreSQL (conteneur officiel, orchestré via OrbStack) ----
POSTGRES_USER=shade
POSTGRES_PASSWORD=shade_dev_password
POSTGRES_DB=shade
POSTGRES_HOST=postgres        # nom du service docker-compose ; `localhost` si lancé hors compose
POSTGRES_PORT=5432

# URL utilisée par SQLAlchemy async (driver asyncpg). En compose, host = `postgres`.
DATABASE_URL=postgresql+asyncpg://shade:shade_dev_password@postgres:5432/shade

# ---- API / Auth ----
API_HOST=0.0.0.0
API_PORT=8000
# Génère une vraie valeur : `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-please-generate-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440        # durée de session (24h)
NONCE_TTL_SECONDS=300          # durée de vie d'un nonce de login (5 min, usage unique)
CORS_ORIGINS=*                 # en prod : liste explicite d'origines

# ---- Solana ----
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# Side wallet du backend (le DÉLÉGATAIRE). C'est la SEULE clé privée détenue par Shade.
# Elle ne peut dépenser QUE les montants explicitement approuvés par les utilisateurs.
# Génère une paire devnet : `python services/api/scripts/gen_side_wallet.py`
# Format : clé secrète base58 (64 bytes) façon Phantom, OU tableau JSON de 64 octets.
SIDE_WALLET_SECRET_KEY=

# Mint utilisé par défaut pour la délégation (wSOL sur devnet).
DEFAULT_DELEGATION_MINT=So11111111111111111111111111111111111111112

# ---- Frontend (Expo) — voir apps/mobile/.env.example ----
# EXPO_PUBLIC_API_URL=http://localhost:8000
