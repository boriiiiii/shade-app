# ============================================================================
# Shade — app mobile (Expo). Copie ce fichier en `.env` et adapte.
# Toutes les variables exposées au client DOIVENT être préfixées EXPO_PUBLIC_.
# ============================================================================

# Base URL du backend FastAPI.
#  - iOS simulator / web            : http://localhost:8000
#  - Émulateur Android              : http://10.0.2.2:8000
#  - Téléphone physique (Expo Go)   : http://<IP-locale-de-ta-machine>:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# DEV SIGNER — clé locale de test (tweetnacl) pour signer/diffuser SANS Phantom.
# Actif UNIQUEMENT si (__DEV__ === true) ET (EXPO_PUBLIC_DEV_SIGNER === "true").
# JAMAIS activer en build de production : le chemin prod = Phantom (deep link).
EXPO_PUBLIC_DEV_SIGNER=true

# Cluster Solana ciblé par le signer applicatif (broadcast des tx utilisateur).
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
