EXPO_PUBLIC_API_URL=

# WalletConnect — requis pour la connexion des wallets EVM (Metamask, Coinbase, Binance).
# Crée un projet gratuit sur https://cloud.walletconnect.com et colle l'ID ici.
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Endpoints RPC (optionnels — des endpoints publics par défaut sont utilisés).
EXPO_PUBLIC_SOLANA_RPC=
EXPO_PUBLIC_ETH_RPC=

# Réseau Solana ciblé pour la connexion Phantom (défaut: mainnet-beta).
EXPO_PUBLIC_SOLANA_CLUSTER=
# URL publique de l'app (présentée à Phantom / WalletConnect).
EXPO_PUBLIC_APP_URL=
