# ============================================================================
# Shade — exemple d'environnement (copie ce fichier en `.env` et adapte)
# AUCUN secret réel ne doit être commit. `.env` est git-ignored.
# ============================================================================

# ---- Runtime ----
ENV=dev                       # dev | staging | prod

# ---- PostgreSQL (conteneur officiel, orchestré via OrbStack) ----
POSTGRES_USER=shade
POSTGRES_PASSWORD=shade_dev_password
POSTGRES_DB=shade
POSTGRES_HOST=postgres        # nom du service docker-compose ; `localhost` si lancé hors compose
POSTGRES_PORT=5432

# URL utilisée par SQLAlchemy async (driver asyncpg). En compose, host = `postgres`.
DATABASE_URL=postgresql+asyncpg://shade:shade_dev_password@postgres:5432/shade

# ---- API / Auth ----
API_HOST=0.0.0.0
API_PORT=8000
# Génère une vraie valeur : `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-please-generate-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440        # durée de session (24h)
NONCE_TTL_SECONDS=300          # durée de vie d'un nonce de login (5 min, usage unique)
CORS_ORIGINS=*                 # en prod : liste EXPLICITE d'origines (ex: https://app.shade.xyz)

# ---- Solana (MAINNET) ----
SOLANA_NETWORK=mainnet-beta
# Clé Helius (https://dashboard.helius.dev). Si fournie, RPC/WS sont dérivés automatiquement
# (mainnet.helius-rpc.com) — laisse SOLANA_RPC_URL/WS_URL vides pour bénéficier de la dérivation.
HELIUS_API_KEY=
# Surcharges manuelles optionnelles (sinon dérivées de HELIUS_API_KEY, sinon RPC public) :
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=xxxx
# SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=xxxx

# ---- DEX (Jupiter aggregator) ----
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1   # tier gratuit ; payant : https://api.jup.ag/swap/v1
JUPITER_API_KEY=                                    # requis pour api.jup.ag (portal.jup.ag)

# Side wallet du backend (le DÉLÉGATAIRE). C'est la SEULE clé privée détenue par Shade.
# Elle ne peut dépenser QUE les montants explicitement approuvés par les utilisateurs.
# ⚠️ MAINNET = ARGENT RÉEL : stocke cette clé dans un secret manager, JAMAIS en clair en prod.
# Génère une paire : `python services/api/scripts/gen_side_wallet.py`, puis FINANCE-la en SOL réel.
# Format : clé secrète base58 (64 bytes) façon Phantom, OU tableau JSON de 64 octets.
SIDE_WALLET_SECRET_KEY=

# Mint utilisé par défaut pour la délégation (wSOL).
DEFAULT_DELEGATION_MINT=So11111111111111111111111111111111111111112

# ---- Garde-fous trading (ARGENT RÉEL — commence petit) ----
MAX_SLIPPAGE_BPS=1000              # plafond dur de slippage (10%)
MAX_TRADE_LAMPORTS=50000000        # 0.05 SOL max par trade
MAX_TOTAL_BUDGET_LAMPORTS=500000000 # 0.5 SOL max de budget délégué
REQUIRE_WHITELIST=true             # whitelist obligatoire pour copytrade / snipe
PRIORITY_FEE_LAMPORTS=0            # 0 => "auto" (Jupiter estime), sinon montant fixe
TRADING_DRY_RUN=false              # true => calcule le swap mais NE broadcast PAS (test sans risque)

# ---- Moteurs autonomes (workers) ----
ENABLE_WORKERS=false               # true => lance copy_watcher + snipe_watcher au démarrage
COPY_POLL_INTERVAL_SECONDS=5
# SNIPE_DEX_PROGRAM_IDS=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8,CPMDWBwJDtYax9qW7AyRuVC19Cc4L4Vcy4n2BHAbHkCW

# ---- Frontend (Expo) — voir apps/mobile/.env.example ----
# EXPO_PUBLIC_API_URL=http://localhost:8000
