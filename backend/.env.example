# ============================================================================
# Shade backend — copie ce fichier en `backend/.env` et adapte.
# Projet démo : aucune valeur ci-dessous n'est un secret réel.
# ============================================================================

# ---- Serveur HTTP / WebSocket ----
PORT=8000
# Origines CORS autorisées (démo : * ). En vrai : liste explicite.
CORS_ORIGINS=*

# ---- Réseau Solana ----
# mainnet-beta | devnet
SOLANA_NETWORK=mainnet-beta
# RPC/WS rapides fortement conseillés pour le sniping (sinon rate-limit public).
# Si HELIUS_API_KEY est fourni, RPC/WS sont dérivés automatiquement.
HELIUS_API_KEY=
# Surcharges manuelles (sinon dérivées de HELIUS_API_KEY, sinon RPC public) :
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=xxxx
# SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=xxxx

# ---- Modèle NON-CUSTODIAL ----
# Le backend ne détient AUCUNE clé. Il détecte des opportunités et construit des
# transactions non signées pour le wallet Phantom connecté ; CHAQUE tx est signée
# et envoyée par l'utilisateur dans Phantom.

# ---- DEX : Jupiter aggregator (construction des swaps) ----
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=
# Mint d'entrée pour un achat (wSOL). On achète toujours avec du SOL.
INPUT_MINT=So11111111111111111111111111111111111111112

# ---- Garde-fous (appliqués à la construction ; l'utilisateur signe ensuite) ----
MAX_TRADE_SOL=0.05          # montant max par ordre
MAX_SLIPPAGE_BPS=1500       # plafond de slippage (15%)
PRIORITY_FEE_LAMPORTS=auto  # "auto" (Jupiter estime) ou un entier en lamports

# ---- Moteur de copytrade ----
COPY_AMOUNT_MODE=fixed      # fixed | proportional
COPY_FIXED_SOL=0.01         # montant fixe copié par trade détecté
COPY_PROPORTIONAL_PCT=100   # % du montant de la cible (mode proportional)

# ---- Moteur de sniping ----
SNIPE_AMOUNT_SOL=0.01
SNIPE_SLIPPAGE_BPS=1500
SNIPE_MAX_DELAY_MS=3000     # délai max après détection avant d'abandonner le snipe
# Programmes on-chain surveillés pour la création de pools (mainnet) :
#   Raydium AMM v4 : 675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8
#   pump.fun       : 6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
SNIPE_PROGRAM_IDS=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8

# ---- Demo feeder (optionnel) ----
# true => génère de fausses détections (cibles qui tradent / nouveaux pools)
# pour voir tout le flux tourner sans attendre un vrai événement on-chain.
DEMO_FEED=false
DEMO_FEED_INTERVAL_MS=12000
