{
  "expo": {
    "name": "Shade",
    "slug": "shade-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "shade",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0A0E14",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shade.mobile"
    },
    "android": {
      "package": "com.shade.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
