# --- existing ---
SUPABASE_URL=
SUPABASE_KEY=

# --- sniping module ---
# Master key used to encrypt side-wallet secrets at rest.
# Generate with:
#   python -c "from sniping.crypto import generate_master_key_b64; print(generate_master_key_b64())"
# 32 random bytes, base64-encoded. Treat like a database password.
SHADE_MASTER_KEY=

# Solana RPC endpoint. Default = devnet. Switch to a private mainnet RPC for prod.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# Hard kill-switch for the swap path. While true, /sniping/snipe/dryrun is the
# only execution path and no real on-chain swap can occur.
SHADE_DRY_RUN=true
